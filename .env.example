# AirFx build settings. Copy to .env.local for local development (never commit .env.local).
# In GitHub, set these as repository Variables (Settings › Secrets and variables › Actions › Variables).

# Supabase project (Project Settings › API). Both values are public by design:
# all data is protected by row-level security. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# true: the editor needs an account. false: guests can use it with local saving.
VITE_REQUIRE_ACCOUNT=false

# cdn: load the AI runtime from jsDelivr (needed on Cloudflare Pages: 25 MiB per-file limit).
# Leave empty to serve it with the app.
AIRFX_ORT_SOURCE=
